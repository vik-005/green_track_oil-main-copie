{# templates/entre_stock/index.html.twig #}
{% extends 'base.html.twig' %}

{# Bloc pour inclure la barre latérale #}
{% block sidebar %}
	{# Inclusion de la barre latérale spécifique à la page d'accueil #}
	{% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{# Titre de la page à afficher dans l'onglet du navigateur #}
{% block title %}Gestion des Stocks
{% endblock %}

{# Contenu principal de la page #}
{% block content %}
	<div
		class="container mt-4">
		{# Affichage des messages flash (succès et erreurs) #}
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
				</div>
			{% endfor %}
		{% endfor %}

		{# Titre principal de la page #}
		<h2 class="text-center mb-4">Liste des Entrées de Stock</h2>

		{# Tableau des entrées de stock #}
		<div class="table-responsive">
			<table class="table table-striped table-hover shadow-sm rounded table-bordered datatable-init">
				<thead class="bg-success text-white">
					<tr>
						<th scope="col">ID</th>
						<th scope="col">Nombre de Bidons</th>
						<th scope="col">Prix Unitaire (FCFA)</th>
						<th scope="col">Total (FCFA)</th>
						<th scope="col">Type d'Huile</th>
						<th scope="col">Nom de l'Agent</th>
						<th scope="col">Nom du Magasinier</th>
						<th scope="col">Date d'Enregistrement</th>
						<th scope="col">Actions</th>
					</tr>
				</thead>
				<tbody>
					{# Boucle pour afficher chaque entrée de stock #}
					{% for entre_stock in entre_stocks %}
						<tr class="text-center align-middle">
							<td>{{ entre_stock.id }}</td>
							<td>{{ entre_stock.nombrebidons }}</td>
							<td>
								{# Vérifiez si l'accès est autorisé #}
								{% if entre_stock.canShowToManager %}
									{{ entre_stock.prixunitaire | number_format(0, ',', ' ') }}
									FCFA
								{% else %}
									<span class="text-danger">Accès refusé</span>
								{% endif %}

							</td>
							
							<td>
								{# Vérifiez si l'accès est autorisé #}
								{% if entre_stock.canShowToManager %}
									{{ entre_stock.total | number_format(0, ',', ' ') }}
									FCFA
								{% else %}
									<span class="text-danger">not access</span>
								{% endif %}

							</td>

							
							<td>{{ entre_stock.typehuile.nomTypeHuile }}</td>
							<td>{{ entre_stock.agent.nomUtilisateur }}</td>
							<td>
								{% if entre_stock.nommagasinier %}
									{{ entre_stock.nommagasinier.nomUtilisateur }}
								{% else %}
									<span class="text-muted">Non attribué</span>
								{% endif %}
							</td>
							<td>{{ entre_stock.dateEnregisterement ? entre_stock.dateEnregisterement|date('d/m/Y H:i') : 'Non disponible' }}</td>
							<td>
								<div
									class="btn-group" role="group" aria-label="Actions">
									{# Bouton Voir #}
									<a href="{{ path('app_entre_stock_show', {'id': entre_stock.id}) }}" class="btn btn-sm btn-info" title="Voir">
										<i class="fas fa-eye"></i>
										Voir
									</a>

									{# Bouton Modifier #}
									<a href="{{ path('app_entre_stock_edit', {'id': entre_stock.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
										<i class="fas fa-edit"></i>
										Modifier
									</a>

									{# Bouton Supprimer #}
									<form method="post" action="{{ path('app_entre_stock_delete', {'id': entre_stock.id}) }}" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette entrée de stock ?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entre_stock.id) }}">
										<button class="btn btn-sm btn-danger" type="submit" title="Supprimer">
											<i class="fas fa-trash"></i>
											Supprimer
										</button>
									</form>
								</div>
							</td>
						</tr>

					{% endfor %}
				</tbody>
			</table>
		</div>

		{# Section pour créer une nouvelle entrée de stock et afficher le total d'enregistrements #}
		<div
			class="d-flex justify-content-between align-items-center mt-3 flex-wrap">
			{# Bouton pour ajouter une nouvelle entrée #}
			<a href="{{ path('app_entre_stock_new') }}" class="btn btn-success btn-sm mb-2">
				<i class="fas fa-plus"></i>
				Créer une nouvelle entrée
			</a>

			{# Affichage du total d'entrées de stock #}
			<span class="text-muted">Total :
				{{ entre_stocks|length }}
				enregistrements</span>
		</div>
	</div>

	<style>
		/* Styles pour le tableau */
		.table thead th {
			background-color: rgb(66, 125, 8); /* Vert */
			color: white;
			vertical-align: middle;
			text-align: center;
		}

		.table tbody td {
			background-color: #f8f9fa; /* Gris clair */
			vertical-align: middle;
			text-align: center;
		}

		/* Styles pour les boutons */
		.btn-info {
			background-color: #17a2b8;
			border-color: #17a2b8;
			transition: background-color 0.3s ease, border-color 0.3s ease;
			color: #fff;
		}

		.btn-info:hover {
			background-color: #138496;
			border-color: #117a8b;
		}

		.btn-warning {
			background-color: #ffc107;
			border-color: #ffc107;
			transition: background-color 0.3s ease, border-color 0.3s ease;
			color: #212529;
		}

		.btn-warning:hover {
			background-color: #e0a800;
			border-color: #d39e00;
		}

		.btn-danger {
			background-color: #dc3545;
			border-color: #dc3545;
			transition: background-color 0.3s ease, border-color 0.3s ease;
			color: #fff;
		}

		.btn-danger:hover {
			background-color: #c82333;
			border-color: #bd2130;
		}

		/* Styles pour les images */
		.img-thumbnail {
			border-radius: 5px;
			max-width: 80px;
			height: 80px;
			object-fit: cover;
		}

		/* Styles pour les alertes */
		.alert {
			max-width: 600px;
			margin: 0 auto 20px;
		}

		/* Styles pour la table responsive */
		@media(max-width: 768px) {
			.table thead {
				display: none;
			}

			.table tbody td {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				padding: 10px;
				border-bottom: 1px solid #dee2e6;
			}

			.table tbody td::before {
				content: attr(data-label);
				font-weight: bold;
				width: 50%;
				display: inline-block;
				text-align: left;
			}

			.btn-group {
				flex-direction: column;
				width: 100%;
			}

			.btn-group .btn,
			.btn-group form {
				width: 100%;
				margin-bottom: 5px;
			}
		}
	</style>
{% endblock %}
