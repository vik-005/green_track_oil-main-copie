{% extends 'base.html.twig' %}

{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Vendor Types Management{% endblock %}

{% block page_title %}
    <div class="container my-4">
        <h1 class="text-center">List of Vendor Types</h1>
    </div>
{% endblock %}

{% block content %}
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Types List</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="thead-dark">
                            <tr>
                                <th scope="col" class="text-center">#</th>
                                <th scope="col">Type Name</th>
                                <th scope="col" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for type_vendeur in type_vendeurs %}
                            <tr>
                                <td class="text-center">{{ type_vendeur.id }}</td>
                                <td>{{ type_vendeur.nomType }}</td>
                                <td class="text-center">
                                    <a href="{{ path('app_type_vendeur_show', {'id': type_vendeur.id}) }}" class="btn btn-info btn-sm me-2">
                                        <i class="fas fa-eye"></i> View
                                    </a>
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_type_vendeur_edit', {'id': type_vendeur.id}) }}" class="btn btn-warning btn-sm me-2">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted">
                                    No vendor types found.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if is_granted('ROLE_ADMIN') %}
                <div class="card-footer text-center">
                    <a href="{{ path('app_type_vendeur_new') }}" class="btn btn-success">
                        <i class="fas fa-plus-circle"></i> Create a New Vendor Type
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
