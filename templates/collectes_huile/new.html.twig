{% extends 'base.html.twig' %}

{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Créer une nouvelle collecte d'huile{% endblock %}

{% block content %}
    <div class="container my-5">
        <div class="row justify-content-between align-items-center mb-4">
            <div class="col-12 col-md-8">
                <h3 class="text-primary">Créer une nouvelle collecte d'huile</h3>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <a href="{{ path('app_collectes_huile_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ include('collectes_huile/_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
