{# templates/collectes_huile/show.html.twig #}
{% extends 'base.html.twig' %}

{% block sidebar %}
	{% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Détails de la Collecte d'Huile
{% endblock %}

{% block page_title %}
	<h2 class="text-center mb-4">Détails de la Collecte d'Huile</h2>
{% endblock %}

{% block content %}
	<div
		class="container mt-4">
		{# Affichage des messages flash #}
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show" role="alert">
					{{ message|trans }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'fermer'|trans }}"></button>
				</div>
			{% endfor %}
		{% endfor %}

		{# Carte de détails de la collecte #}


		<div class="card shadow rounded">
			<div class="card-header bg-primary text-white">
				<h5 class="mb-0">Collecte d'Huile #{{ collectes_huile.id }}</h5>
			</div>
			<div class="card-body">
				<div class="row mb-3">
					<div class="col-md-4">
						<strong>Volume (L) :</strong>
					</div>
					<div class="col-md-8">{{ collectes_huile.volume }}
						L</div>
				</div>
				<div class="row mb-3">
					<div class="col-md-4">
						<strong>Photos des Bidons :</strong>
					</div>
					<div class="col-md-8">
						{% if collectes_huile.photoBidons %}
							<div id="carousel-photos" class="carousel slide" data-bs-ride="carousel">
								<div class="carousel-inner">
									{% for photoBidons in collectes_huile.photoBidons %}
										<div class="carousel-item {% if loop.first %}active{% endif %}">
											<img src="{{ asset('uploads/photos/' ~ photoBidons) }}" class="d-block w-100" alt="Photo Bidons" style="max-height: 400px; object-fit: cover; border-radius: 10px;">
										</div>
									{% endfor %}
								</div>
								<button class="carousel-control-prev" type="button" data-bs-target="#carousel-photos" data-bs-slide="prev">
									<span class="carousel-control-prev-icon" aria-hidden="true"></span>
									<span class="visually-hidden">Previous</span>
								</button>
								<button class="carousel-control-next" type="button" data-bs-target="#carousel-photos" data-bs-slide="next">
									<span class="carousel-control-next-icon" aria-hidden="true"></span>
									<span class="visually-hidden">Next</span>
								</button>
							</div>
						{% else %}
							<span class="text-muted">{{ 'Aucune photo disponible'|trans }}</span>
						{% endif %}
					</div>
				</div>
				<div class="row mb-3">
					<div class="col-md-4">
						<strong>Prix Achat (FCFA) :</strong>
					</div>
					<div class="col-md-8">{{ collectes_huile.prixAchat|number_format(0, ',', ' ') }}
						FCFA / Litre</div>
				</div>
				<div class="row mb-3">
					<div class="col-md-4">
						<strong>Date Collecte :</strong>
					</div>
					<div class="col-md-8">{{ collectes_huile.dateCollecte ? collectes_huile.dateCollecte|date('d/m/Y H:i:s') : 'Non disponible' }}</div>
				</div>
				<div class="row mb-3">
					<div class="col-md-4">
						<strong>Statut :</strong>
					</div>
					<div class="col-md-8">
						<span class="badge bg-success">{{ collectes_huile.statutLabel }}</span>
					</div>
				</div>
			</div>
			<div class="card-footer text-end">
				<a href="{{ path('app_collectes_huile_index') }}" class="btn btn-secondary">
					<i class="fas fa-arrow-left"></i>
					Retour
				</a>
				<a href="{{ path('app_collectes_huile_pdf', { 'id': collectes_huile.id }) }}" class="btn btn-info">
					<i class="fas fa-file-pdf"></i>
					Télécharger PDF
				</a>
				<button class="btn btn-success" onclick="window.print();">
					<i class="fas fa-print"></i>
					Imprimer
				</button>
				<a href="{{ path('app_collectes_huile_edit', { 'id': collectes_huile.id }) }}" class="btn btn-warning">
					<i class="fas fa-edit"></i>
					Modifier
				</a>
				{{ include('collectes_huile/_delete_form.html.twig') }}
			</div>

		</div>
	</div>

	{# Styles supplémentaires #}
	<style>
		.card {
			border: none;
		}
		.card-header {
			font-size: 1.2rem;
			font-weight: bold;
		}
		.carousel img {
			border-radius: 10px;
			margin-bottom: 1rem;
		}
		.badge {
			font-size: 1rem;
		}
		@media(max-width: 768px) {
			.card-header h5 {
				font-size: 1rem;
			}
		}
	</style>

	{# Ajouter Bootstrap si non inclus #}
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
