{% extends 'base.html.twig' %}

{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block content %}
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">List of Oil Types</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-bordered rounded shadow table datatable-init">
                        <thead class="text-nowrap text-white">
                            <tr>
                                <th scope="col" >Oil Count</th>
                                <th scope="col" >Oil Type Name</th>
                                <th scope="col" class="text-center ">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for types_huile in types_huiles %}
                            <tr class="align-middle">
                                <td class="text-center">{{ types_huile.id }}</td>
                                <td class="text-center">{{ types_huile.nomTypeHuile }}</td>
                                <td class="text-center">
                                    <a href="{{ path('app_types_huile_show', {'id': types_huile.id}) }}" class="btn btn-outline-primary" title="View Details">
                                        <i class="fas fa-eye"></i> View
                                    </a>

                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('app_types_huile_edit', {'id': types_huile.id}) }}" class="btn btn-outline-warning text-black" title="Edit">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form method="post" action="{{ path('app_types_huile_delete', {'id': types_huile.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this oil type?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ types_huile.id) }}">
                                            <button class="btn btn-outline-danger" title="Delete">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                 {% if is_granted('ROLE_ADMIN') %}
                <div class="d-flex justify-content-between mt-3">
                    <a href="{{ path('app_types_huile_new') }}" class="btn btn-success">
                        <i class="fas fa-plus"></i> Create New
                    </a>
                    <span class="text-muted">Total: {{ types_huiles|length }} Oil Types</span>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
