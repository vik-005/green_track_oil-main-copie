{% extends 'base.html.twig' %}

{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Oil Types{% endblock %}

{% block page_title %}
    <div class="text-center my-4">
        <h1 class="display-5 fw-bold">Used Oil Type</h1>
        <p class="text-muted">Management and detailed information</p>
    </div>
{% endblock %}

{% block content %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow border-0">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Oil Type Details</h5>
                        <span class="badge bg-success">ID: {{ types_huile.id }}</span>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover">
                            <tbody>
                                <tr>
                                    <th scope="row" class="text-muted">Oil Type Name</th>
                                    <td class="fw-semibold">{{ types_huile.nomTypeHuile }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer bg-light d-flex justify-content-between">
                        <a href="{{ path('app_types_huile_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-list"></i> Back to the list
                        </a>
                        <div>
                            <a href="{{ path('app_types_huile_edit', {'id': types_huile.id}) }}" class="btn btn-outline-primary me-2">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            {{ include('types_huile/_delete_form.html.twig', { 'class': 'btn btn-outline-danger' }) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
