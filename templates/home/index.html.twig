{% extends 'base.html.twig' %}
{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block content %}
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>GreenWaste Oil Collection Platform</title>
        <link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body {
                font-family: 'Arial', sans-serif;
                background-color: #f4f4f9;
                color: #333;
            }

            header {
                background-image: url('huiles.jpg');
                background-size: cover;
                background-position: center;
                color: white;
                padding: 150px 0;
                text-align: center;
                position: relative;
            }

            header::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.5);
                z-index: 1;
            }

            header h1, header p {
                z-index: 2;
                position: relative;
            }

            header h1 {
                font-size: 3.5rem;
                font-weight: bold;
                color: #fff;
            }

            header h5 {
                font-size: 1.5rem;
                font-weight: 400;
                color: #c8fb53;
            }

            header .btn {
                background-color: #428107;
                color: white;
                padding: 12px 24px;
                font-size: 18px;
                border-radius: 25px;
                transition: all 0.3s ease;
            }

            header .btn:hover {
                background-color: #356005;
                transform: scale(1.1);
            }

            section {
                padding: 60px 0;
            }

            section h2 {
                font-size: 2.5rem;
                font-weight: bold;
                text-align: center;
                margin-bottom: 30px;
                color: #2c3e50;
            }

            .card {
                transition: all 0.3s ease-in-out;
                border: none;
                border-radius: 10px;
                overflow: hidden;
            }

            .card:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
            }

            .card img {
                filter: brightness(0.8);
                transition: all 0.3s ease;
            }

            .card:hover img {
                filter: brightness(1);
            }

            footer {
                background-color: #122501;
                color: white;
                text-align: center;
                padding: 20px 0;
                margin-top: 50px;
            }

            footer a {
                color: #c8fb53;
                text-decoration: none;
                font-weight: bold;
            }

            footer a:hover {
                text-decoration: underline;
            }
        </style>
    </head>

    <body>
        <!-- Header Section -->
        <header>
            <div class="container">
                <h1>Welcome to GreenWaste Oil Collection</h1>
                <h5>Your partner in eco-friendly oil recycling for a greener planet.</h5>
                <a href="#contact" class="btn">Contact Us</a>
            </div>
        </header>

        <!-- About Section -->
        <section id="about">
            <div class="container">
                <h2>About GreenWaste Oil Collection</h2>
                <p class="text-center">
                    For years, GreenWaste Oil Collection has been committed to eco-friendly practices by collecting, treating, and recycling used oils. Partnering with restaurants, hotels, and industries across Benin, we ensure top-quality services while safeguarding the environment.
                </p>
                <p class="text-center mt-4">
                    Our expertise contributes to reducing pollution by transforming waste oils into valuable resources like biodiesel. With innovation and efficiency at the forefront, we meet client needs while adhering to strict ecological standards.
                </p>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="bg-light">
            <div class="container">
                <h2>Our Services</h2>
                <div class="row mt-5">
                    <div class="col-md-4">
                        <div class="card">
                            <img src="huiles.jpg" class="card-img-top" alt="Oil Collection">
                            <div class="card-body">
                                <h5 class="card-title">Used Oil Collection</h5>
                                <p class="card-text">We offer reliable and timely oil collection services, catering to both large industrial quantities and smaller amounts from restaurants.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <img src="huiles.jpg" class="card-img-top" alt="Ecological Treatment">
                            <div class="card-body">
                                <h5 class="card-title">Ecological Treatment</h5>
                                <p class="card-text">Our processes minimize the carbon footprint by transforming used oils into reusable materials while protecting ecosystems.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card">
                            <img src="huiles.jpg" class="card-img-top" alt="Recycling">
                            <div class="card-body">
                                <h5 class="card-title">Recycling for Bioenergy</h5>
                                <p class="card-text">We recycle collected oils to produce bioenergy, contributing to the circular economy and renewable energy generation.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section id="contact">
            <div class="container">
                <h2>Contact Us</h2>
                <p class="text-center">Have questions or need our services? Reach out via phone or email. We're committed to providing prompt, professional responses.</p>
                <p class="text-center"><strong>Phone:</strong> +229 12 34 56 78</p>
                <p class="text-center"><strong>Email:</strong> info@greenwaste.com</p>
            </div>
        </section>

       
    </body>

    </html>
{% endblock %}
