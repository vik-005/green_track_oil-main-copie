{# templates/stock/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Détails du Stock{% endblock %}

{% block content %}
    <h1>Détails du Stock</h1>

    <div>
        <h2>Type d'Huile</h2>
        <p>{{ stock.typehuile.nom }}</p>
    </div>

    <div>
        <h2>Quantité Initiale</h2>
        <p>{{ stock.quantiteInitiale }}</p>
    </div>

    <div>
        <h2>Quantité Stockée</h2>
        <p>{{ stock.quantiteStockee }}</p>
    </div>

    <div>
        <h2>Magasinier</h2>
        <p>{{ stock.nommagasinier.nom }}</p>
    </div>

    <div>
        <h2>Vendeur</h2>
        <p>{{ stock.nomvendeur.nom }}</p>
    </div>

    <div>
        <a href="{{ path('app_stock_edit', {'id': stock.id}) }}">Modifier</a>
    </div>

    <div>
        <a href="{{ path('app_stock_index') }}">Retour à la liste des Stocks</a>
    </div>
{% endblock %}
