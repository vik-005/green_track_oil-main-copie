{% extends 'base.html.twig' %}

{% block title %}Utilisateurs index{% endblock %}

{% block content %}
    <h1>Liste des utilisateurs</h1>
    <table class="table datatable-init">
        <thead class="text-nowrap ">
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Photo</th>
                <th>Date de création</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for utilisateur in utilisateurs %}
            <tr>
                <td>{{ utilisateur.nomUtilisateur }}</td>
                <td>{{ utilisateur.prenomutilisateur }}</td>
                <td>{{ utilisateur.email }}</td>
                <td>
                    {% for role in utilisateur.roles %}
                        <span>{{ role }}</span>
                    {% endfor %}
                </td>
                <td>
                    {% if utilisateur.photo %}
                        <img src="{{ asset('uploads/photos/' ~ utilisateur.photo) }}" alt="Photo de {{ utilisateur.nomUtilisateur }}" class="img-fluid" style="max-width: 100px; height: auto;">
                    {% else %}
                        <span>Pas de photo</span>
                    {% endif %}
                </td>
                <td>{{ utilisateur.dateCreation ? utilisateur.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_utilisateur_show', {'id': utilisateur.id}) }}">Voir</a>
                    <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun utilisateur trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_utilisateur_new') }}">Créer un nouvel utilisateur</a>
{% endblock %}
