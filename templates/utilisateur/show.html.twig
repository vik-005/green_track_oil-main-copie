{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Détails de l'utilisateur</h1>

        <div class="card">
            <div class="card-header">
                Informations sur l'utilisateur
            </div>
            <div class="card-body">
                <table class="table">
                    <tbody>
                        <tr>
                            <th scope="row">Id</th>
                            <td>{{ utilisateur.id }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Nom d'utilisateur</th>
                            <td>{{ utilisateur.nomUtilisateur }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Prénom</th>
                            <td>{{ utilisateur.prenomutilisateur }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Email</th>
                            <td>{{ utilisateur.email }}</td>
                        </tr>
                        <tr>
                            <th scope="row">Rôles</th>
                            <td>
                                {% for role in utilisateur.roles %}
                                    <span class="badge bg-primary">{{ role }}</span>
                                {% endfor %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Photo</th>
                            <td>
                                {% if utilisateur.photo %}
                                    <img src="{{ asset('uploads/photos/' ~ utilisateur.photo) }}" alt="Photo de {{ utilisateur.nomUtilisateur }}" class="img-fluid" style="max-width: 100px; height: auto;">
                                {% else %}
                                    <span>Pas de photo</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th scope="row">Date de création</th>
                            <td>{{ utilisateur.dateCreation ? utilisateur.dateCreation|date('Y-m-d H:i:s') : 'N/A' }}</td>
                        </tr>
                    </tbody>
                </table>

                <div class="mt-4">
                    <a href="{{ path('app_utilisateur_index') }}" class="btn btn-secondary">Retour à la liste</a>
                    <a href="{{ path('app_utilisateur_edit', {'id': utilisateur.id}) }}" class="btn btn-warning">Modifier</a>
                    {{ include('utilisateur/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
