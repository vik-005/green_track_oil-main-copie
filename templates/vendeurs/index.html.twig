{% extends 'base.html.twig' %}

{% block sidebar %}
	{% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Vendor List{% endblock %}

{% block content %}
	<div class="container my-4">
		<h2 class="text-center mb-4">Vendor List</h2>

		{# Display flash messages #}
		{% for label, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
					{{ message }}
					<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
				</div>
			{% endfor %}
		{% endfor %}

		<div class="table-responsive">
			<table class="table table-striped table-hover shadow-sm rounded table-bordered datatable-init">
				<thead class="bg-success text-white">
					<tr>
						<th>Name</th>
						<th>Address</th>
						<th>City</th>
						<th>Country</th>
						<th>Phone</th>
						<th>Email</th>
						<th>Vendor Type</th>
						<th>Latitude</th>
						<th>Longitude</th>
						<th>Photos</th>
						<th>Creation Date</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% if vendeurs is empty %}
						<tr>
							<td colspan="12" class="text-center">No vendors found</td>
						</tr>
					{% else %}
						{% for vendeur in vendeurs %}
							<tr>
								<td>{{ vendeur.nomVendeur }}</td>
								<td>{{ vendeur.adresse }}</td>
								<td>{{ vendeur.ville }}</td>
								<td>{{ vendeur.pays }}</td>
								<td>{{ vendeur.telephone }}</td>
								<td>{{ vendeur.email }}</td>
								<td>{{ vendeur.typevendeur ? vendeur.typevendeur.nomtype : 'N/A' }}</td>
								<td>{{ vendeur.latitude }}</td>
								<td>{{ vendeur.longitude }}</td>
								<td></td>
								<td>{{ vendeur.getFormattedDateCreation() }}</td>
								<td class="text-nowrap">
									<div class="btn-group" role="group" aria-label="Actions">
										{# View - visible to all users #}
										<a href="{{ path('app_vendeurs_show', {'id': vendeur.id}) }}" class="btn btn-info btn-sm">
											<i class="fas fa-eye"></i> View
										</a>

										{# Edit - visible only to admins #}
										{% if is_granted('ROLE_ADMIN') %}
											<a href="{{ path('app_vendeurs_edit', {'id': vendeur.id}) }}" class="btn btn-warning btn-sm">
												<i class="fas fa-edit"></i> Edit
											</a>
										{% endif %}

										{# Export to PDF - visible only to admins #}
										{% if is_granted('ROLE_ADMIN') %}
											<a href="{{ path('app_vendeurs_export_pdf') }}" class="btn btn-primary">
												<i class="fas fa-file-pdf"></i> Export to PDF
											</a>
										{% endif %}

										{# Delete - visible only to admins #}
										{% if is_granted('ROLE_ADMIN') %}
											<form method="post" action="{{ path('app_vendeurs_delete', {'id': vendeur.id}) }}" onsubmit="return confirm('Are you sure you want to delete this vendor?');" style="display:inline;">
												<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ vendeur.id) }}">
												<button class="btn btn-danger btn-sm" type="submit">
													<i class="fas fa-trash-alt"></i> Delete
												</button>
											</form>
										{% endif %}
									</div>
								</td>
							</tr>
						{% endfor %}
					{% endif %}
				</tbody>
			</table>
		</div>

		<div class="d-flex justify-content-end mt-3">
			{# Add a new vendor - visible only to admins #}
			{% if is_granted('ROLE_ADMIN') %}
				<a href="{{ path('app_vendeurs_new') }}" class="btn btn-success">
					<i class="fas fa-plus"></i> Add a New Vendor
				</a>
			{% endif %}
		</div>
	</div>

	{# Necessary scripts for Bootstrap 5 #}
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			var carousels = document.querySelectorAll('.carousel');
			carousels.forEach(function (carousel) {
				new bootstrap.Carousel(carousel, {
					interval: 2000,
					ride: 'carousel'
				});
			});
		});
	</script>

	<style>
		/* Styles for the table */
		.table thead th {
			background-color: #28a745; /* Green */
			color: white;
			vertical-align: middle;
			text-align: center;
		}

		.table tbody td {
			background-color: #f8f9fa; /* Light gray */
			vertical-align: middle;
			text-align: center;
		}

		/* Styles for the buttons */
		.btn-success {
			background-color: #28a745;
			border-color: #28a745;
			transition: background-color 0.3s ease;
		}

		.btn-success:hover {
			background-color: #218838;
			border-color: #1e7e34;
		}

		.btn-info {
			background-color: #17a2b8;
			border-color: #17a2b8;
			transition: background-color 0.3s ease;
		}

		.btn-info:hover {
			background-color: #138496;
			border-color: #117a8b;
		}

		.btn-warning {
			background-color: #ffc107;
			border-color: #ffc107;
			transition: background-color 0.3s ease;
		}

		.btn-warning:hover {
			background-color: #e0a800;
			border-color: #d39e00;
		}

		.btn-danger {
			background-color: #dc3545;
			border-color: #dc3545;
			transition: background-color 0.3s ease;
		}

		.btn-danger:hover {
			background-color: #c82333;
			border-color: #bd2130;
		}

		/* Styles for images */
		.img-thumbnail {
			border-radius: 5px;
		}

		/* Styles for alerts */
		.alert {
			max-width: 600px;
			margin: 0 auto 20px;
		}

		/* Styles for the responsive table */
		@media(max-width: 768px) {
			.table thead {
				display: none;
			}

			.table tbody td {
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				padding: 10px;
				border-bottom: 1px solid #dee2e6;
			}

			.table tbody td::before {
				content: attr(data-label);
				font-weight: bold;
				width: 50%;
				display: inline-block;
				text-align: left;
			}

			.table tbody td img {
				max-width: 80px;
				height: 80px;
			}

			.btn-group {
				flex-direction: column;
				width: 100%;
			}

			.btn-group .btn,
			.btn-group form {
				width: 100%;
				margin-bottom: 5px;
			}
		}
	</style>
{% endblock %}
