{% extends 'base.html.twig' %}

{% block title %}Hello StatistisqueController!{% endblock %}

{% block content %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Statistiques des Collectes d'Huile</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center">Statistiques des Collectes d'Huile</h1>

        <div class="row mt-4">
            <div class="col-md-6">
                <h2>Total Huile Collectée par Mois</h2>
                <canvas id="totalOilPerMonthChart" width="400" height="200"></canvas>
            </div>
            <div class="col-md-6">
                <h2>Volume Total d'Huile Collectée</h2>
                <p class="lead">{{ total_volume_collected }} L</p>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <h2>Huile Collectée par Agent</h2>
                <ul class="list-group">
                    {% for agent in oil_per_agent %}
                        <li class="list-group-item">
                            {{ agent.agentName }}: {{ agent.totalVolume }} L
                        </li>
                    {% endfor %}
                </ul>
            </div>
            <div class="col-md-6">
                <h2>Huile Collectée par Type de Vendeur</h2>
                <ul class="list-group">
                    {% for type in oil_per_vendor_type %}
                        <li class="list-group-item">
                            {{ type.vendorType }}: {{ type.totalVolume }} L
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <h2>Total Collectes par Mois</h2>
                <canvas id="totalCollectionsPerMonthChart" width="400" height="200"></canvas>
            </div>
            <div class="col-md-6">
                <h2>Top 5 Clients</h2>
                <ul class="list-group">
                    {% for client in top_clients %}
                        <li class="list-group-item">
                            {{ client.client }}: {{ client.total_collectes }} collectes
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <script>
        // Graphique pour le total d'huile collectée par mois
        var totalOilPerMonthChart = new Chart(document.getElementById('totalOilPerMonthChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: {{ total_oil_per_month | map(attribute='month') | json_encode() }},
                datasets: [{
                    label: 'Total Huile (L)',
                    data: {{ total_oil_per_month | map(attribute='totalVolume') | json_encode() }},
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Graphique pour le nombre total de collectes par mois
        var totalCollectionsPerMonthChart = new Chart(document.getElementById('totalCollectionsPerMonthChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: {{ total_collections_per_month | map(attribute='month') | json_encode() }},
                datasets: [{
                    label: 'Nombre de Collectes',
                    data: {{ total_collections_per_month | map(attribute='totalCollections') | json_encode() }},
                    backgroundColor: 'rgba(153, 102, 255, 0.2)',
                    borderColor: 'rgba(153, 102, 255, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
</body>
</html>
