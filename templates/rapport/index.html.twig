{% extends 'base.html.twig' %}

{% block title %}Liste des Rapports{% endblock %}

{% block page_title %}
    <h2 class="text-center mb-4">Liste des Rapports ({{ waitingRapportCount() }})</h2>
{% endblock %}

{% block content %}
<div class="container">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a href="{{ path('rapport_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Créer un nouveau rapport
        </a>
        <div>
            <a href="{{ path('rapport_export_pdf') }}" class="btn btn-danger mx-1">
                <i class="fas fa-file-pdf"></i> Exporter en PDF
            </a>
            <a href="" class="btn btn-success mx-1">
                <i class="fas fa-file-excel"></i> Exporter en Excel
            </a>
            <form action="" method="post" enctype="multipart/form-data" class="d-inline-block mx-1">
                <label for="excelImport" class="btn btn-secondary">
                    <i class="fas fa-upload"></i> Importer Excel
                </label>
                <input type="file" id="excelImport" name="excelFile" style="display: none;" onchange="this.form.submit()">
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered rounded shadow datatable-init">
            <thead class="bg-primary text-white text-nowrap">
                <tr>
                    <th>Id</th>
                    <th>Numéro du Resto</th>
                    <th>Nom du Restaurant</th>
                    <th>Rencontre</th>
                    <th>Adresse</th>
                    <th>Commentaire</th>
                    <th>Date de Demande</th>
                    <th>Date d'Approbation</th>
                    <th>Supérieur</th>
                    <th>Agent</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for rapport in rapports %}
                    <tr>
                        <td>{{ rapport.id }}</td>
                        <td>{{ rapport.numresto }}</td>
                        <td>{{ rapport.nomrestaurant }}</td>
                        <td>{{ rapport.rencontre }}</td>
                        <td>{{ rapport.Adresse }}</td>
                        <td>{{ rapport.commentaire ?: 'Aucun commentaire' }}</td>
                        <td>{{ rapport.dateDemande ? rapport.dateDemande|date('d/m/Y H:i') : 'N/A' }}</td>
                        <td>{{ rapport.dateApprobation ? rapport.dateApprobation|date('d/m/Y H:i') : 'N/A' }}</td>
                        <td>{{ rapport.superieure }}</td>
                        <td>{{ rapport.agent.nomUtilisateur }}</td>
                        <td>
                            <span class="badge 
                                {% if rapport.getStatutLabel == 'Approuvé' %}
                                    bg-success
                                {% elseif rapport.getStatutLabel == 'Rejeté' %}
                                    bg-danger
                                {% else %}
                                    bg-warning
                                {% endif %}">
                                {{ rapport.getStatutLabel }}
                            </span>
                        </td>
                        <td>
                            <a href="{{ path('rapport_show', {'id': rapport.id}) }}" class="btn btn-info btn-sm mx-1">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="{{ path('rapport_edit', {'id': rapport.id}) }}" class="btn btn-warning btn-sm mx-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form method="post" action="{{ path('rapport_delete', {'id': rapport.id}) }}" class="d-inline-block mx-1" onsubmit="return confirm('Confirmer la suppression ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rapport.id) }}">
                                <button class="btn btn-danger btn-sm" type="submit">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<style>
    .btn {
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .btn:hover {
        transform: translateY(-2px);
    }
</style>
{% endblock %}
