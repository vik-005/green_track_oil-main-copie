{% extends 'base.html.twig' %}

{% block title %}Créer un Nouveau Rapport{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
            <h1 class="text-center mb-4">Créer un Nouveau Rapport</h1>
            
            <div class="card shadow-sm">
                <div class="card-body">
                    {{ include('rapport/_form.html.twig') }}
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <a href="{{ path('rapport_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
                <button type="submit" form="rapport_form" class="btn btn-primary">
                    <i class="bi bi-save"></i> Enregistrer
                </button>
            </div>
        </div>
    </div>
</div>
{% endblock %}
