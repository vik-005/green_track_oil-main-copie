{% extends 'base.html.twig' %}

{% block title %}Modifier le Rapport{% endblock %}

{% block content %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <h1 class="mb-4 text-center">Modifier le Rapport</h1>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ include('rapport/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a href="{{ path('rapport_index') }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Retour à la liste
                </a>
                {{ include('rapport/_delete_form.html.twig', { 'class': 'btn btn-danger' }) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
