{% extends 'base.html.twig' %}

{% block sidebar %}
    {% include "_partials/sidebar/sidebar_home.html.twig" %}
{% endblock %}

{% block title %}Modifier la collecte d'huile{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Modifier la Collecte d'Huile</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'needs-validation'}}) }}
                    
                        <div class="mb-3">
                            {{ form_label(form.statutLabel, 'Prix d\'achat (par litre)', {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.statutLabel, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.statutLabel) }}
                        </div>

                        <button class="btn btn-primary w-100 mt-3">
                            <i class="fas fa-save"></i> Mettre à jour
                        </button>
                    {{ form_end(form) }}
                </div>
                <div class="card-footer text-center">
                    <a href="{{ path('collectes_huile_index') }}" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
